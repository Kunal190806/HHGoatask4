USE GRAPH FraudGraph

CREATE QUERY get_device_neighbors(STRING input_device_id) FOR GRAPH FraudGraph {
  /*
   * Traverses from a specific device to find all transactions made from it,
   * then to the associated cards, and finally checks if any of those cards 
   * are linked to a ClosedCase (especially confirmed fraud).
   */
  
  SumAccum<INT> @txn_count;
  SetAccum<STRING> @@compromised_cards;
  
  Start = {DeviceProfile.*};
  TargetDevice = SELECT s FROM Start:s WHERE s.device_id == input_device_id;
  
  // Get all transactions from this device
  Txns = SELECT t FROM TargetDevice:s -(FROM_DEVICE_REVERSE:e)- Transaction:t;
  
  // Get cards used in these transactions
  Cards = SELECT c FROM Txns:t -(MADE_TXN_REVERSE:e)- Card:c
          ACCUM c.@txn_count += 1;
          
  // Find cases attached to these cards
  Cases = SELECT ca FROM Cards:c -(CASE_ON_CARD_REVERSE:e)- ClosedCase:ca
          WHERE ca.outcome == "confirmed_fraud"
          ACCUM @@compromised_cards += c.card_id;
          
  PRINT Cards;
  PRINT Cases;
  PRINT @@compromised_cards;
}

INSTALL QUERY get_device_neighbors
